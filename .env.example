# Bromo configuration. Copy to .env and never commit .env.
# This file is the single reference for every variable.
# A line like "# NAME=value" is optional and shows the default.
# Generate secrets yourself, for example with: openssl rand -hex 24

# Required. No default, the app refuses to start in prod without them.
# ClickHouse admin, used only to create users and tables at first start.
CLICKHOUSE_ADMIN_PASSWORD=
CLICKHOUSE_INGEST_PASSWORD=
CLICKHOUSE_API_PASSWORD=
CLICKHOUSE_AGENT_PASSWORD=
CLICKHOUSE_FINDINGS_PASSWORD=
# Bearer key for POST /api/v1/events. The replayer reads the same variable.
BROMO_API_KEY=
# Comma separated bearer tokens for POST /api/v1/chat.
BROMO_CHAT_TOKENS=
# Daily LLM spend cap in USD. Chat is refused when it is reached.
BROMO_LLM_DAILY_BUDGET_USD=1.00
# Any LiteLLM model name, for example deepseek/deepseek-chat or gemini/<model>.
LLM_MODEL=
# Set only the key for the provider in LLM_MODEL (DEEPSEEK_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, and so on).
DEEPSEEK_API_KEY=

# Optional: connections.
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_HTTP_PORT=8123
# AGENT_GRPC_TARGET=localhost:50051
# BROMO_INGEST_URL=http://localhost:8080/api/v1/events

# Optional: API behavior.
# Location of the data contract file (event rules, fields, layers, gold tables, metrics).
# BROMO_DATA_CONTRACT=config/data-contract.yml
# SPRING_PROFILES_ACTIVE=dev
# MANAGEMENT_SERVER_PORT=8081
# BROMO_PUBLIC_READ=false
# BROMO_MAX_EVENT_BYTES=65536
# BROMO_MAX_BATCH_EVENTS=500
# BROMO_CHAT_RATE_PER_MINUTE=10

# Optional: agent behavior.
# DETECT_INTERVAL_SECONDS=30
# AGENT_MAX_TOOL_CALLS=8
# AGENT_MAX_TOKENS=20000
# AGENT_TIMEOUT_SECONDS=60
# AGENT_GRPC_PORT=50051
# Notification target for new findings. Off when empty.
# FINDINGS_WEBHOOK_URL=
